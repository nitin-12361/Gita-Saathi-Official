<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/ic_launcher_background"
    android:padding="14dp">

    <!-- Header Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ॐ"
            android:textColor="#FFA726"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="गीता साथी • आज का श्लोक"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_verse_ref"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="2.47"
            android:textColor="#FFE082"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Sanskrit Shloka Text -->
    <TextView
        android:id="@+id/widget_shloka_text"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="8dp"
        android:text="कर्मण्येवाधिकारस्ते मा फलेषु कदाचन।"
        android:textColor="#FFE082"
        android:textSize="14sp"
        android:textStyle="bold"
        android:gravity="center_vertical"
        android:maxLines="3"
        android:ellipsize="end" />

    <!-- Translation / Meaning -->
    <TextView
        android:id="@+id/widget_meaning_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="तुम्हारा अधिकार केवल कर्म करने में है, उसके फलों में कभी नहीं।"
        android:textColor="#E0E0E0"
        android:textSize="11sp"
        android:maxLines="2"
        android:ellipsize="end" />

</LinearLayout>
